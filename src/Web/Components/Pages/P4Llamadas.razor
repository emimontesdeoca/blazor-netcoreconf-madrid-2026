@page "/llamadas"
@inject Diagnostico Diag

<PageTitle>4 · Cambiar la vista sin repetir la consulta</PageTitle>

<h1>4 · Cambiar la vista no debe repetir la consulta</h1>
<p class="intro">
    Cambia entre la vista completa y compacta. El aspecto cambia, pero el pedido es el mismo:
    en modo rápido solo se consulta la API al seleccionar otro pedido.
</p>

<ModoSelector @bind-Rapido="_rapido" @bind-Rapido:after="ReiniciarEscenario"
              DescripcionLento="Cada cambio de parámetro vuelve a consultar el pedido, aunque solo cambie la presentación."
              DescripcionRapido="La presentación cambia sin consultar de nuevo. Solo se carga el pedido si cambia su Id." />

<section>
    <p class="barra">
        <label>Pedido:
            <select @bind="_pedidoId">
                @for (var id = 1; id <= 10; id++)
                {
                    <option value="@id">#@id</option>
                }
            </select>
        </label>
        <label class="opcion-vista">
            <input type="checkbox" @bind="_vistaCompacta" />
            Vista compacta
        </label>
    </p>
    @if (_rapido)
    {
        <DetallePedidoRapido PedidoId="_pedidoId" VistaCompacta="_vistaCompacta" />
    }
    else
    {
        <DetallePedidoLento PedidoId="_pedidoId" VistaCompacta="_vistaCompacta" />
    }
</section>

@code {
    private bool _rapido;
    private int _pedidoId = 1;
    private bool _vistaCompacta;

    private void ReiniciarEscenario() => Diag.Reiniciar();
}
