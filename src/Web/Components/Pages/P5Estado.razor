@page "/estado"
@inject PedidosApi Api
@inject Diagnostico Diag

<PageTitle>5 · El carrito no debería renderizar la tabla</PageTitle>

<h1>5 · Añadir al carrito no debería renderizar la tabla</h1>
<p class="intro">
    Dos componentes comparten estado: el <b>carrito</b> y el <b>filtro de la tabla</b>.
    Añade un pedido y observa los renders. La tabla no usa los datos del carrito.
</p>

<ModoSelector @bind-Rapido="_rapido" @bind-Rapido:after="ReiniciarEscenario"
              DescripcionLento="Un evento general notifica al carrito y a la tabla. Añadir al carrito vuelve a renderizar ambos."
              DescripcionRapido="El carrito solo notifica al carrito; el filtro solo actualiza la tabla." />

@if (_pedidos.Count == 0)
{
    <p>Cargando pedidos…</p>
}
else
{
    <div class="estado-demo">
        @if (_rapido)
        {
            <CarritoRapido PedidoId="@_pedidos[0].Id" />
            <TablaRapida Pedidos="_pedidos" />
        }
        else
        {
            <CarritoLento PedidoId="@_pedidos[0].Id" />
            <TablaLenta Pedidos="_pedidos" />
        }
    </div>
}

@code {
    private bool _rapido;
    private IReadOnlyList<Pedido> _pedidos = [];

    private void ReiniciarEscenario() => Diag.Reiniciar();

    protected override async Task OnInitializedAsync()
        => _pedidos = await Api.GetPedidosAsync(200);
}
