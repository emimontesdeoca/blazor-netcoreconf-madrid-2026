@* ⚡ RÁPIDO: no muestra datos del estado compartido, así que no se suscribe.
   Se renderiza al recibir el clic en uno de sus botones. *@
@inject EstadoRapido Estado
@inject Diagnostico Diag
@{ Diag.Render(nameof(OfertasRapidas)); }

<div class="tarjeta ofertas ok">
    <span class="titulo">🔥 Ofertas del día</span>
    @foreach (var p in Pedidos.Take(3))
    {
        <button @onclick="() => Estado.AñadirAlCarrito(p.Id)">Añadir @p.Producto</button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Pedido> Pedidos { get; set; } = [];
}
