@* 🐢 LENTO: se suscribe a OnChange y se renderiza al añadir un producto al carrito, aunque el filtro no cambie. *@
@inject EstadoLento Estado
@inject Diagnostico Diag
@implements IDisposable
@{ Diag.Render(nameof(FiltroLento)); }

<div class="tarjeta filtro">
    <span class="titulo">Filtro</span>
    <select @onchange="Cambiar">
        <option value="">Todos los estados</option>
        @foreach (var e in Enum.GetValues<EstadoPedido>())
        {
            <option value="@e" selected="@(Estado.Filtro == e)">@e</option>
        }
    </select>
</div>

@code {
    private Action? _handler;

    protected override void OnInitialized()
    {
        _handler = () => InvokeAsync(StateHasChanged);
        Estado.OnChange += _handler;
    }

    private void Cambiar(ChangeEventArgs e)
        => Estado.CambiarFiltro(Enum.TryParse<EstadoPedido>(e.Value?.ToString(), out var f) ? f : null);

    public void Dispose()
    {
        if (_handler is not null) Estado.OnChange -= _handler;
    }
}
