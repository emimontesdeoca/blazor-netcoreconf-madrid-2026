@* 🐢 LENTO: el evento global también actualiza la tabla. *@
@inject EstadoLento Estado
@inject Diagnostico Diag
@implements IDisposable
@{ Diag.Render("Carrito"); }

<div class="tarjeta carrito">
    <span class="titulo">🛒 Carrito</span>
    <span class="valor">@Estado.Carrito.Count</span>
    <button @onclick="Añadir">Añadir pedido #@PedidoId</button>
</div>

@code {
    [Parameter] public int PedidoId { get; set; }

    private Action? _handler;

    private void Añadir() => Estado.AñadirAlCarrito(PedidoId);

    protected override void OnInitialized()
    {
        _handler = () => InvokeAsync(StateHasChanged);
        Estado.OnChange += _handler;
    }

    public void Dispose()
    {
        if (_handler is not null) Estado.OnChange -= _handler;
    }
}
