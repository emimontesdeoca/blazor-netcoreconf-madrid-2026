@* 🐢 LENTO
   La tabla usa el filtro, pero también recibe las notificaciones del carrito. *@
@inject EstadoLento Estado
@inject Diagnostico Diag
@implements IDisposable
@{
    Diag.Render("Tabla");
    IReadOnlyList<Pedido> filtrados = Estado.Filtro is null
        ? Pedidos
        : Pedidos.Where(p => p.Estado == Estado.Filtro).ToList();
}

<div class="tarjeta tabla">
    <div class="tabla-cabecera">
        <span class="titulo">Pedidos (@filtrados.Count)</span>
        <label>Estado
            <select @onchange="CambiarFiltro">
                <option value="" selected="@(Estado.Filtro is null)">Todos</option>
                @foreach (var estado in Enum.GetValues<EstadoPedido>())
                {
                    <option value="@estado" selected="@(Estado.Filtro == estado)">@estado</option>
                }
            </select>
        </label>
    </div>
    <div class="scroll corto">
        <table class="pedidos">
            <tbody>
                @foreach (var p in filtrados)
                {
                    <tr>
                        <td>@p.Id</td>
                        <td>@p.Cliente</td>
                        <td>@p.Producto</td>
                        <td class="num">@p.Importe.ToString("C", CultureInfo.GetCultureInfo("es-ES"))</td>
                        <td><span class="estado @p.Estado.ToString().ToLowerInvariant()">@p.Estado</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Pedido> Pedidos { get; set; } = [];

    private Action? _handler;

    private void CambiarFiltro(ChangeEventArgs e)
        => Estado.CambiarFiltro(Enum.TryParse<EstadoPedido>(e.Value?.ToString(), out var filtro) ? filtro : null);

    protected override void OnInitialized()
    {
        _handler = () => InvokeAsync(StateHasChanged);
        Estado.OnChange += _handler;
    }

    public void Dispose()
    {
        if (_handler is not null) Estado.OnChange -= _handler;
    }
}
