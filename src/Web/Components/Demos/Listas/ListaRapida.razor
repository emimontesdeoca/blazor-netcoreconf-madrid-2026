@inject PedidosApi Api
@inject IJSRuntime JS
@inject Diagnostico Diag
@implements IDisposable
@{ Diag.Render(nameof(ListaRapida)); }

<Medidor Tiempo="_tiempo" FilasDom="_filasDom" Cargados="_cargados" />

<div @ref="_lista" id="lista" class="scroll">
    <table class="pedidos fijas">
        <thead>
            <tr><th>#</th><th>Cliente</th><th>Producto</th><th class="num">Cant.</th><th class="num">Importe</th><th>Estado</th></tr>
        </thead>
        <tbody>
            @if (BajoDemanda)
            {
                <Virtualize TItem="Pedido" ItemsProvider="CargarPagina" ItemSize="38" OverscanCount="5" SpacerElement="tr" Context="p">
                    <ItemContent>
                        <tr data-pedido="@p.Id">
                            <td>@p.Id</td>
                            <td>@p.Cliente</td>
                            <td>@p.Producto</td>
                            <td class="num">@p.Cantidad</td>
                            <td class="num">@p.Importe.ToString("C", CultureInfo.GetCultureInfo("es-ES"))</td>
                            <td><span class="estado @p.Estado.ToString().ToLowerInvariant()">@p.Estado</span></td>
                        </tr>
                    </ItemContent>
                    <Placeholder>
                        <tr class="placeholder"><td colspan="6">Cargando…</td></tr>
                    </Placeholder>
                </Virtualize>
            }
            else if (_pedidos.Count > 0)
            {
                <Virtualize TItem="Pedido" Items="_pedidos" ItemSize="38" OverscanCount="5" SpacerElement="tr" Context="p">
                    <tr data-pedido="@p.Id">
                        <td>@p.Id</td>
                        <td>@p.Cliente</td>
                        <td>@p.Producto</td>
                        <td class="num">@p.Cantidad</td>
                        <td class="num">@p.Importe.ToString("C", CultureInfo.GetCultureInfo("es-ES"))</td>
                        <td><span class="estado @p.Estado.ToString().ToLowerInvariant()">@p.Estado</span></td>
                    </tr>
                </Virtualize>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public bool BajoDemanda { get; set; }

    private ICollection<Pedido> _pedidos = [];
    private readonly Stopwatch _cronometro = Stopwatch.StartNew();
    private readonly CancellationTokenSource _cts = new();
    private ElementReference _lista;
    private TimeSpan? _tiempo;
    private int? _filasDom;
    private int _cargados;

    protected override async Task OnInitializedAsync()
    {
        if (BajoDemanda) return;
        try
        {
            _pedidos = (await Api.GetPedidosAsync(5000, _cts.Token)).ToList();
            _cargados = _pedidos.Count;
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
    }

    private async ValueTask<ItemsProviderResult<Pedido>> CargarPagina(ItemsProviderRequest peticion)
    {
        var (items, total) = await Api.GetPaginaAsync(peticion.StartIndex, peticion.Count, peticion.CancellationToken);
        peticion.CancellationToken.ThrowIfCancellationRequested();
        _cargados = items.Count;
        await InvokeAsync(StateHasChanged);
        return new ItemsProviderResult<Pedido>(items, total);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _filasDom = await JS.InvokeAsync<int>("diag.medirFilas", _cts.Token, _lista);
            _tiempo = _cronometro.Elapsed;
            StateHasChanged();
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested) { }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
